import Erdos722CubicOrderBound
import Mathlib.NumberTheory.LSeries.PrimesInAP
import BruckRyserCertificate

/-!
# Bruck–Ryser obstructions for square-order Steiner designs

The pinned proof of the projective-plane theorem is by Dugongue.
The transfer to the Erdős 722 predicate uses affine completion and
successive derivatives of the design.
-/

namespace Erdos722.InversiveOrder
open Finset IntegralDesign MinimumOrder

private theorem bruck_ryser {q : ℕ} (hp : PlaneOfOrder q)
    (hm : q ≡ 1 [MOD 4] ∨ q ≡ 2 [MOD 4]) : ∃ a b, q=a^2+b^2 := by
  obtain ⟨P,L,m,f,g,pp,h⟩ := hp
  exact @OMA.solution P L m f g q pp h hm

/-- One obstruction for every rank on the square boundary, including
the affine and inversive cases at s=0 and s=1. -/
theorem square_sum_two_squares {q : ℕ} (hq : 2≤q) (s : ℕ)
    {H : Finset (Finset (Fin (q^2+s)))} (hH : H.IsBlockDesign (2+s) (q+s))
    (hm : q ≡ 1 [MOD 4] ∨ q ≡ 2 [MOD 4]) : ∃ a b, q=a^2+b^2 :=
  bruck_ryser (plane_of_square_design hq s hH) hm

theorem square_prime_exclusion {q p : ℕ} (hq : 2≤q) (s : ℕ)
    (hm : q ≡ 1 [MOD 4] ∨ q ≡ 2 [MOD 4]) (hp : p∈q.primeFactors)
    (hp₄ : p%4=3) (ho : ¬Even (padicValNat p q)) :
    ¬∃ H : Finset (Finset (Fin (q^2+s))), H.IsBlockDesign (2+s) (q+s) := by
  rintro ⟨H,hH⟩
  exact ho (Nat.eq_sq_add_sq_iff.mp (square_sum_two_squares hq s hH hm) p hp hp₄)

private theorem no_plane_mod_nine {q : ℕ} (hm : q ≡ 1 [MOD 4] ∨ q ≡ 2 [MOD 4])
    (ht : q%9=3 ∨ q%9=6) : ¬PlaneOfOrder q :=
  fun h => mod_nine_obstruction ht (bruck_ryser h hm)

/-- In the four residue classes 6,21,30,33 modulo 36, the signed
index-one equations have a solution and the ordinary design is impossible. -/
theorem signed_inversive_obstruction {q : ℕ} (hq : 2≤q)
    (hm : q ≡ 1 [MOD 4] ∨ q ≡ 2 [MOD 4]) (ht : q%9=3 ∨ q%9=6) :
    (∃ w, Represents (univ : Finset (Fin (q^2+1))) 3 (q+1) (fun _ => 1) w) ∧
      ¬∃ H : Finset (Finset (Fin (q^2+1))), H.IsBlockDesign 3 (q+1) :=
  square_signed_separation hq (no_plane_mod_nine hm ht)

/-- Written in the host's cutoff quantifier order. Every cutoff for this
block size must exceed the order of the excluded inversive plane. -/
theorem inversive_cutoff (t N : ℕ)
    (h : ∀ n≥N, (∀ i<3, (36*t+7-i).choose (3-i) ∣ (n-i).choose (3-i)) →
      ∃ H : Finset (Finset (Fin n)), H.IsBlockDesign 3 (36*t+7)) : (36*t+6)^2+1<N := by
  apply square_cutoff_of_no_plane (q:=36*t+6) (by omega) _ h
  exact no_plane_mod_nine (Or.inr (by change (36*t+6)%4=2; omega)) (Or.inr (by omega))

theorem seven_lower {v : ℕ} (hv : 7<v) {H : Finset (Finset (Fin v))}
    (hH : H.IsBlockDesign 3 7) : 77≤v :=
  seven_lower_of_no_six (no_plane_mod_nine (Or.inr (by decide)) (Or.inr (by decide))) hv hH

/-- A prime p≡3 modulo 4 occurs to odd exponent in 2p. Bruck–Ryser
excludes the sole square-boundary candidate; every larger admissible
order satisfies the cubic estimate. -/
theorem double_prime_order_bound {v p : ℕ} (hp : p.Prime) (hm : p%4=3)
    (hv : 2*p+1<v) {H : Finset (Finset (Fin v))} (hH : H.IsBlockDesign 3 (2*p+1)) :
    p^6*(2*p+1)≤v^3 := by
  have hp₃ : 3≤p := by omega
  have hl := triple_square_lower (by omega : 3<2*p+1) hv (by omega) (by omega) (by omega) hH
  simp only [Nat.add_sub_cancel] at hl
  have hp₂ : ¬p∣2 := fun hd => (by have := Nat.le_of_dvd (by decide : 0<2) hd; omega)
  let : Fact p.Prime := ⟨hp⟩
  have hval : padicValNat p (2*p)=1 := by
    rw [padicValNat.mul (by decide) hp.ne_zero,padicValNat_self,padicValNat.eq_zero_of_not_dvd hp₂]
  have hne : v≠(2*p)^2+1 := by
    rintro rfl
    apply square_prime_exclusion (by omega : 2≤2*p) 1
      (Or.inr (by change (2*p)%4=2; omega))
      (Nat.mem_primeFactors.mpr ⟨hp,dvd_mul_left ..,by positivity⟩) hm _ ⟨H,hH⟩
    rw [hval]
    decide
  apply cubic_bound_above_square hp hp₃ (by omega)
  exact (signed_steiner_iff v 3 (2*p+1) (by omega) hv.le).mp ⟨_,design_weights hH⟩

/-- For any fixed multiple C of the square of the block size, arbitrarily
large prime parameters force every nontrivial design above that multiple. -/
theorem unbounded_quadratic_ratio (C B : ℕ) :
    ∃ p>B, p.Prime ∧ p%4=3 ∧ ∀ v, 2*p+1<v →
      (∃ H : Finset (Finset (Fin v)), H.IsBlockDesign 3 (2*p+1)) → C*(2*p+1)^2<v := by
  obtain ⟨p,hpB,hp,hm⟩ := Nat.forall_exists_prime_gt_and_modEq (max B ((9*C)^3))
    (by decide : 4≠0) (by decide : Nat.Coprime 3 4)
  change p%4=3 at hm
  refine ⟨p,by omega,hp,hm,?_⟩
  rintro v hv ⟨H,hH⟩
  have h := double_prime_order_bound hp hm hv hH
  by_contra! hle
  have hp₁ := hp.pos
  have hle' : v≤(9*C)*p^2 := hle.trans (by
    calc
      C*(2*p+1)^2 ≤ C*(3*p)^2 := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left (by omega) 2)
      _ = _ := by ring)
  have hy := (Nat.pow_le_pow_left hle' 3)
  rw [show ((9*C)*p^2)^3=p^6*(9*C)^3 by ring] at hy
  have := Nat.le_of_mul_le_mul_left (h.trans hy) (by positivity)
  omega

#print axioms OMA.solution
#print axioms double_prime_order_bound
#print axioms unbounded_quadratic_ratio
#print axioms square_sum_two_squares
#print axioms square_prime_exclusion
#print axioms signed_inversive_obstruction
#print axioms inversive_cutoff
#print axioms seven_lower
end Erdos722.InversiveOrder
