import Erdos722HananiInflation
import Erdos722PrimePowerProducts

/-!
# Orders generated by two-stem inflation and Wilson's product

The conditional statements expose the 22-point input. The accompanying
Witt specialization discharges it by a checked finite witness.
-/

namespace Erdos722.TwoStem
open PointedProduct

theorem iterated_order (seed : ExistsDesign 5 22) {a : ℕ} (master : ExistsDesign 5 (a+1)) (d : ℕ) :
    ExistsDesign 5 ((4^d*(3*a+1)+2)/3) := by
  have he := orbit_formula a d
  have h : (4^d*(3*a+1)+2)/3=orbit a d+1 := by omega
  rw [h]
  exact orbit_design seed master d

theorem four_generator_orders (seed : ExistsDesign 5 22) (u v w z : ℕ) :
    ExistsDesign 5 (5^u*21^v*85^w*341^z+1) := by
  have hp := (by decide : Nat.Prime 5).isPrimePow
  have base : ExistsDesign 5 (5^u*21^v+1) := PrimePower.mixed_orders hp seed u v
  have first : ExistsDesign 5 (85+1) := hanani_of_seed seed (v:=21) seed
  have second : ExistsDesign 5 (341+1) := hanani_of_seed seed (v:=85) first
  exact PrimePower.product hp (PrimePower.product hp base (PrimePower.power_order hp first w))
    (PrimePower.power_order hp second z)

/-- Every positive power of 85 is separated from every earlier
punctured product 5^u 21^v by its prime factor 17. -/
theorem separated_orders (d u v : ℕ) : 85^(d+1)+1≠5^u*21^v+1 := by
  intro he
  have hd : 17∣85^(d+1) := by
    rw [pow_succ]
    exact dvd_mul_of_dvd_right (by decide : 17∣85) _
  have hp : Nat.Prime 17 := by decide
  rw [Nat.add_right_cancel he] at hd
  rcases hp.dvd_mul.mp hd with h|h
  · exact (by decide : ¬17∣5) (hp.dvd_of_dvd_pow h)
  · exact (by decide : ¬17∣21) (hp.dvd_of_dvd_pow h)

theorem infinite_extension (seed : ExistsDesign 5 22) :
    Set.Infinite {n | ExistsDesign 5 n ∧ ∀ u v : ℕ, n≠5^u*21^v+1} := by
  let f (d : ℕ) := 85^(d+1)+1
  have hf : Function.Injective f := fun a b h =>
    Nat.succ_inj.mp (Nat.pow_right_injective (by decide : 2≤85) (Nat.succ_inj.mp h))
  apply (Set.infinite_range_of_injective hf).mono
  rintro _ ⟨d,rfl⟩
  exact ⟨by simpa [f] using four_generator_orders seed 0 0 (d+1) 0,separated_orders d⟩

#print axioms iterated_order
#print axioms four_generator_orders
#print axioms separated_orders
#print axioms infinite_extension
end Erdos722.TwoStem
