set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
def fourteen : Rule (Fin 14) := ofTable fourteenTable (by
  intro a
  fin_cases a <;> decide +kernel)

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
def thirtyEight : Rule (Fin 38) := ofTable thirtyEightTable (by
  intro a
  fin_cases a <;> decide +kernel)

/-- The three disjoint columns have twelve ordinary points each. All share
the stem consisting of points 36 and 37. -/
def embed (i : Fin 3) (x : Fin 14) : Fin 38 :=
  ⟨if x.val < 12 then 12*i.val+x.val else x.val+24,by split <;> omega⟩

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem embed_completion : ∀ (i : Fin 3) (a b c : Fin 14),
    embed i (fourteen.complete a b c) =
    thirtyEight.complete (embed i a) (embed i b) (embed i c) := by
  intro i a
  fin_cases i <;> fin_cases a <;> decide +kernel

#print axioms fourteen
#print axioms thirtyEight
#print axioms embed_completion

end Erdos722.HananiTemplate
