import Erdos722QuadCompletion
import Mathlib.Logic.Equiv.Fin.Basic

/-!
# Hanani's 38-point template with two common points

The 38-point quadruple system has three copies of the same 14-point
quadruple system. Each pair of copies intersects in precisely the two stem
points. A packed table gives the completion of each unordered triple.
-/

namespace Erdos722.HananiTemplate
open QuadCompletion
variable {n : ℕ} [NeZero n]

/-- Each row is indexed by the largest point of a strictly increasing
triple. The pair of smaller points has rank b(b−1)/2 + a in that row. -/
private def lookup (t : Array ℕ) (a b c : Fin n) : Fin n :=
  let lo := min a.val (min b.val c.val)
  let hi := max a.val (max b.val c.val)
  let mid := a.val + b.val + c.val - lo - hi
  let pos := mid * (mid - 1) / 2 + lo
  Fin.ofNat n (((t.getD hi 0) >>> (6 * pos)) % 64)

private def complete (t : Array ℕ) (a b c : Fin n) : Fin n :=
  if a=b then c else if a=c then b else if b=c then a else lookup t a b c

private theorem lookup_swap₁ (t : Array ℕ) (a b c : Fin n) :
    lookup t a b c = lookup t b a c := by
  unfold lookup
  ac_rfl

private theorem lookup_swap₂ (t : Array ℕ) (a b c : Fin n) :
    lookup t a b c = lookup t a c b := by
  unfold lookup
  ac_rfl

private def ofTable (t : Array ℕ)
    (h : ∀ a b c : Fin n, complete t a b (complete t a b c) = c) : Rule (Fin n) where
  complete := complete t
  swap₁ a b c := by
    by_cases hab : a = b
    · subst b; rfl
    by_cases hac : a = c
    · subst c; simp [complete,hab,Ne.symm hab]
    by_cases hbc : b = c
    · subst c; simp [complete,hab,Ne.symm hab]
    simpa [complete,hab,Ne.symm hab,hac,hbc] using lookup_swap₁ t a b c
  swap₂ a b c := by
    by_cases hab : a = b
    · subst b; by_cases h : a = c <;> simp_all [complete]
    by_cases hac : a = c
    · subst c; simp [complete,hab]
    by_cases hbc : b = c
    · subst c; rfl
    simpa [complete,hab,hac,hbc,Ne.symm hbc] using lookup_swap₂ t a b c
  repeated a b := by simp [complete]
  cancel := h

