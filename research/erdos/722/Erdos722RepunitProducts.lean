import Erdos722HananiSpectrum
import Erdos722SmallWitness42
import Mathlib.Data.Nat.GCD.Basic

/-!
# Punctured orders generated by base-four repunits and 41

Hanani's recurrence started at the vacuous one-point design produces
R(d) = (4^d-1)/3. Wilson's pointed product combines arbitrary finite
powers of these orders with the 42-point design.
-/

namespace Erdos722.SmallOrders
open PointedProduct TwoStem

def repunit (d : ℕ) : ℕ := orbit 0 d

theorem three_mul_repunit (d : ℕ) : 3 * repunit d = 4^d - 1 := by
  have h := orbit_formula 0 d
  simp only [Nat.mul_zero, Nat.zero_add, Nat.mul_one] at h
  unfold repunit
  omega

theorem repunit_gcd (a b : ℕ) :
    (repunit a).gcd (repunit b) = repunit (a.gcd b) := by
  have h := Nat.pow_sub_one_gcd_pow_sub_one 4 a b
  simp only [← three_mul_repunit,Nat.gcd_mul_left] at h
  omega

theorem one_lt_repunit {d : ℕ} (hd : 2≤d) : 1 < repunit d := by
  have h := three_mul_repunit d
  have hlo : 4^2 ≤ 4^d := Nat.pow_le_pow_right (by decide) hd
  omega

/-- Prime indices give mutually coprime generators, all strictly larger than one. -/
theorem prime_repunits {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hne : p≠q) :
    1 < repunit p ∧ (repunit p).Coprime (repunit q) := by
  refine ⟨one_lt_repunit hp.two_le,?_⟩
  change (repunit p).gcd (repunit q) = 1
  rw [repunit_gcd, ((Nat.coprime_primes hp hq).mpr hne).gcd_eq_one]
  rfl

/-- The new punctured seed 41 is coprime to every prime-index repunit. -/
theorem coprime_forty_one (p : ℕ) (hp : p.Prime) : (repunit p).Coprime 41 := by
  by_cases h₂ : p=2
  · subst p; decide
  by_cases h₅ : p=5
  · subst p; decide
  have hcop : p.Coprime 10 := by
    apply hp.coprime_iff_not_dvd.mpr
    rw [show 10=2*5 by decide]
    intro h
    rcases hp.dvd_mul.mp h with h|h
    · exact h₂ ((Nat.dvd_prime Nat.prime_two).mp h |>.resolve_left hp.ne_one)
    · exact h₅ ((Nat.dvd_prime (by decide : Nat.Prime 5)).mp h |>.resolve_left hp.ne_one)
  have hr : (repunit p).Coprime (repunit 10) := by
    change (repunit p).gcd (repunit 10) = 1
    rw [repunit_gcd,hcop.gcd_eq_one]
    rfl
  exact hr.of_dvd_right (by decide : 41 ∣ repunit 10)

private theorem repunit_order (seed : ExistsDesign 5 22) (d : ℕ) :
    ExistsDesign 5 (repunit d+1) := by
  apply orbit_design seed
  refine ⟨∅,fun _ h => (Finset.notMem_empty _ h).elim,?_⟩
  intro T hT
  have h := T.card_le_univ
  simp [hT] at h

/-- Infinitely many different primes divide punctured orders. The least
prime factor of R(p) is injective on the primes by pairwise coprimality. -/
theorem prime_divisors_of_witt (seed : ExistsDesign 5 22) :
    Set.Infinite {q : ℕ | q.Prime ∧ ∀ N, ∃ n>N, ExistsDesign 5 n ∧ q ∣ n-1} := by
  let f (p : ℕ) := (repunit p).minFac
  have prime (p : ℕ) (hp : p.Prime) : (f p).Prime :=
    Nat.minFac_prime (one_lt_repunit hp.two_le).ne'
  have inj : Set.InjOn f {p | p.Prime} := by
    intro p hp q hq he
    by_contra hne
    have hd : f p ∣ (repunit p).gcd (repunit q) :=
      Nat.dvd_gcd (Nat.minFac_dvd _) (he ▸ Nat.minFac_dvd _)
    rw [(prime_repunits hp hq hne).2.gcd_eq_one] at hd
    exact (prime _ hp).not_dvd_one hd
  apply (Nat.infinite_setOfPred_prime.image inj).mono
  rintro _ ⟨p,hp,rfl⟩
  refine ⟨prime p hp,?_⟩
  intro N
  have hlo := Nat.pow_le_pow_left (one_lt_repunit hp.two_le : 2 ≤ repunit p) (N+1)
  have hN : N+1 < 2^(N+1) := Nat.lt_two_pow_self
  have hbig : N+1 < (repunit p)^(N+1) := lt_of_lt_of_le hN hlo
  refine ⟨(repunit p)^(N+1)+1,by omega,
    PrimePower.power_order (by decide : Nat.Prime 5).isPrimePow (repunit_order seed p) (N+1),?_⟩
  simp only [Nat.add_sub_cancel, pow_succ]
  exact dvd_mul_of_dvd_right (Nat.minFac_dvd _) _

/-- The exponents and indices are arbitrary, and the empty product is included. -/
theorem products_of_witt (seed : ExistsDesign 5 22) (a : ℕ) (s : Finset ℕ) (e : ℕ → ℕ) :
    ∃ H : Finset (Finset (Fin (41^a * (∏ d ∈ s, repunit d ^ e d) + 1))),
      H.IsBlockDesign 3 6 := by
  classical
  have hp := (by decide : Nat.Prime 5).isPrimePow
  change ExistsDesign 5 (41^a * (∏ d ∈ s, repunit d ^ e d) + 1)
  induction s using Finset.induction_on with
  | empty => simpa using PrimePower.power_order hp Witness42.order_forty_two a
  | @insert d s hd ih =>
    have hr := PrimePower.power_order hp (repunit_order seed d) (e d)
    rw [Finset.prod_insert hd]
    have hj : ExistsDesign 5 ((41^a * (∏ t ∈ s, repunit t^e t)) * repunit d^e d + 1) :=
      PrimePower.product hp ih hr
    simpa [Nat.mul_assoc,Nat.mul_left_comm,Nat.mul_comm] using hj

/-- Powers of the 42-point seed give infinitely many orders outside the earlier
four-generator family. This assertion only needs the 42-point certificate. -/
theorem infinite_forty_one_extension :
    Set.Infinite {n | (∃ H : Finset (Finset (Fin n)), H.IsBlockDesign 3 6) ∧
      ∀ u v w z : ℕ, n ≠ 5^u * 21^v * 85^w * 341^z + 1} := by
  let f (d : ℕ) := 41^(d+1)+1
  have hf : Function.Injective f := fun _ _ h =>
    Nat.succ_inj.mp (Nat.pow_right_injective (by decide : 2 ≤ 41) (Nat.succ_inj.mp h))
  apply (Set.infinite_range_of_injective hf).mono
  rintro _ ⟨d,rfl⟩
  refine ⟨PrimePower.power_order (by decide : Nat.Prime 5).isPrimePow Witness42.order_forty_two (d+1),?_⟩
  intro u v w z he
  have hd : 41 ∣ 41^(d+1) := dvd_pow_self _ (Nat.succ_ne_zero d)
  rw [show 41^(d+1)=5^u*21^v*85^w*341^z from Nat.add_right_cancel he] at hd
  have hp : Nat.Prime 41 := by decide
  simp only [hp.dvd_mul] at hd
  rcases hd with ((h|h)|h)|h
  · exact (by decide : ¬41∣5) (hp.dvd_of_dvd_pow h)
  · exact (by decide : ¬41∣21) (hp.dvd_of_dvd_pow h)
  · exact (by decide : ¬41∣85) (hp.dvd_of_dvd_pow h)
  · exact (by decide : ¬41∣341) (hp.dvd_of_dvd_pow h)

#print axioms repunit
#print axioms one_lt_repunit
#print axioms prime_divisors_of_witt
#print axioms infinite_forty_one_extension
#print axioms three_mul_repunit
#print axioms repunit_gcd
#print axioms prime_repunits
#print axioms coprime_forty_one
#print axioms products_of_witt
end Erdos722.SmallOrders
