import Erdos478GapPatternMeans
import Mathlib.NumberTheory.Cyclotomic.PrimitiveRoots

/-!
# An explicit lower density for simultaneous saturation

The field generated by all chosen roots is a compositum. Its degree is
at most the product of the individual splitting degrees. The cyclotomic
factor contributes its totient and a gap of length k contributes at most k!.
-/

namespace Erdos478.SplittingDensity
open Polynomial Finset IntermediateField
open scoped Classical Cyclotomic

private theorem compositum_le {K : Type} [Field K] [Algebra ℚ K] (t : ℤ[X] → IntermediateField ℚ K) (s : Finset ℤ[X]) :
    Module.finrank ℚ (⨆ f∈s, t f : IntermediateField ℚ K) ≤ ∏ f∈s, Module.finrank ℚ (t f) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    have he : (⨆ f∈(∅ : Finset ℤ[X]), t f) = ⊥ :=
      bot_unique (iSup_le fun f => iSup_le fun h => (notMem_empty f h).elim)
    exact ((congrArg (fun L : IntermediateField ℚ K => Module.finrank ℚ L) he).trans
      IntermediateField.finrank_bot).le.trans_eq prod_empty.symm
  | insert f s hf ih =>
    rw [Finset.iSup_insert,prod_insert hf]
    exact (finrank_sup_le ..).trans (Nat.mul_le_mul_left _ ih)

private theorem splitting_product_le (s : Finset ℤ[X]) (hm : ∀ f∈s, f.Monic) :
    Module.finrank ℚ (SplitField (∏ f∈s, f)) ≤ ∏ f∈s, Module.finrank ℚ (SplitField f) := by
  let K := AlgebraicClosure ℚ
  let q (f : ℤ[X]) := f.map (Int.castRingHom ℚ)
  let t (f : ℤ[X]) := IntermediateField.adjoin ℚ ((q f).rootSet K)
  have hi (f) : IsSplittingField ℚ (t f) (q f) :=
    adjoin_rootSet_isSplittingField (IsAlgClosed.splits _)
  have he : (∏ f∈s, f).map (Int.castRingHom ℚ)=∏ f∈s, q f := Polynomial.map_prod ..
  let L := (⨆ f∈s, t f : IntermediateField ℚ K)
  let : IsSplittingField ℚ L (∏ f∈s, q f) :=
    isSplittingField_iSup (t:=t) (monic_prod_of_monic _ _ (fun f hf => (hm f hf).map _)).ne_zero (fun f _ => hi f)
  have hD : Module.finrank ℚ (SplitField (∏ f∈s, f))=Module.finrank ℚ L := by
    unfold SplitField
    rw [he]
    exact (IsSplittingField.algEquiv L _).toLinearEquiv.finrank_eq.symm
  rw [hD]
  exact (compositum_le t s).trans_eq (prod_congr rfl (by
    intro f _
    let : IsSplittingField ℚ (t f) (q f) := hi f
    exact (IsSplittingField.algEquiv (t f) (q f)).toLinearEquiv.finrank_eq))

private theorem gap_field_le {k : ℕ} (hk : 0<k) : Module.finrank ℚ (SplitField (gapPoly k))≤k.factorial := by
  let F := (gapPoly k).map (Int.castRingHom ℚ)
  let K := F.SplittingField
  let : IsGalois ℚ K := { to_isSeparable := inferInstance, to_normal := SplittingField.instNormal F }
  let : Fact ((F.map (algebraMap ℚ K)).Splits) := ⟨SplittingField.splits F⟩
  have hi := Nat.card_le_card_of_injective _ (Gal.galActionHom_injective F K)
  rw [Nat.card_perm,Nat.card_coe_set_eq] at hi
  have he : F.natDegree=k := ((gap_degree hk).monic.natDegree_map _).trans (gap_degree hk).natDegree_eq
  exact (IsGalois.card_aut_eq_finrank ℚ K).ge.trans (hi.trans (Nat.factorial_le ((F.ncard_rootSet_le K).trans_eq he)))

private theorem cyclo_degree {m : ℕ} (hm : 0<m) : Module.finrank ℚ (SplitField (cyclotomic m ℤ))=m.totient := by
  let : NeZero m := ⟨hm.ne'⟩
  let : NeZero (m : ℚ) := ⟨by exact_mod_cast hm.ne'⟩
  let : IsCyclotomicExtension {m} ℚ (CyclotomicField m ℚ) := CyclotomicField.isCyclotomicExtension m ℚ
  let : IsSplittingField ℚ (CyclotomicField m ℚ) (cyclotomic m ℚ) :=
    IsCyclotomicExtension.splitting_field_cyclotomic m ℚ _
  unfold SplitField
  rw [map_cyclotomic]
  exact (IsSplittingField.algEquiv (CyclotomicField m ℚ) (cyclotomic m ℚ)).toLinearEquiv.finrank_eq.symm.trans
    (IsCyclotomicExtension.finrank _ (cyclotomic.irreducible_rat hm))

theorem field_degree_bound {m : ℕ} (hm : 0<m) (S : Finset ℕ) (hS : ∀ k∈S, 0<k) :
    Module.finrank ℚ (SplitField (test m S)) ≤ m.totient * ∏ k∈S, k.factorial := by
  classical
  let D (f : ℤ[X]) := Module.finrank ℚ (SplitField f)
  have hg : (∏ f∈S.image gapPoly, D f)≤∏ k∈S, k.factorial := by
    rw [prod_image]
    · exact prod_le_prod' fun k hk => gap_field_le (hS k hk)
    · intro i hi j hj h
      exact (gap_degree (hS i hi)).natDegree_eq.symm.trans
        ((congrArg natDegree h).trans (gap_degree (hS j hj)).natDegree_eq)
  have hmon : ∀ f∈factors m S, f.Monic := by
    intro f hf
    rcases mem_insert.mp hf with rfl|hf
    · exact cyclotomic.monic _ _
    · obtain ⟨k,hk,rfl⟩ := mem_image.mp hf
      exact (gap_degree (hS k hk)).monic
  apply (splitting_product_le _ hmon).trans
  change (∏ f∈insert (cyclotomic m ℤ) (S.image gapPoly), D f)≤_
  by_cases hx : cyclotomic m ℤ∈S.image gapPoly
  · rw [insert_eq_of_mem hx]
    exact hg.trans (by simpa using Nat.mul_le_mul_right (∏ k∈S, k.factorial) (Nat.totient_pos.mpr hm))
  · rw [prod_insert hx]
    exact Nat.mul_le_mul (cyclo_degree hm).le hg

/-- Each gap contributes at most one factorial factor to the denominator,
regardless of intersections among the splitting fields. -/
theorem density_lower_bound {m : ℕ} (hm : 0<m) (S : Finset ℕ) (hS : ∀ k∈S, 0<k) :
    ((m.totient * ∏ k∈S, k.factorial : ℕ) : ℝ)⁻¹ ≤ splitDensity m S := by
  apply inv_anti₀ (by exact_mod_cast (Module.finrank_pos (R:=ℚ) (M:=SplitField (test m S))))
  exact_mod_cast field_degree_bound hm S hS

#print axioms field_degree_bound
#print axioms density_lower_bound
end Erdos478.SplittingDensity
