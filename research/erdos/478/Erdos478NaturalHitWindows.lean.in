import Erdos478TiltedHitWindows
import Erdos478NaturalConditionalHits
import Erdos478NaturalFrobeniusBands

/-! # Distinct prime gap lengths in proportional and dyadic windows -/

namespace Erdos478.ConditionalGaps
open Filter Finset Topology BinaryGap FrobeniusBands GapSieve GapDensity
open scoped Classical
noncomputable section

theorem ordinary_window {H : ℕ → ℕ} {L b z A : ℝ} (hL : 1<L)
    (hw : Tendsto (fun K : ℕ => (H K:ℝ)/K) atTop (𝓝 L)) (hb : 0≤b)
    (hz : 0<z) (hz₁ : z<1) (hA : A<b*Real.log z-(L-1)/3*Real.log ((1+z)/2)) :
    ∀ᶠ K : ℕ in atTop, ∀ᶠ X : ℕ in atTop, 1-Real.exp (-A*K/Real.log K)<fraction X (fun p =>
      let U := GapSieve.hits (family K (H K)) p
      b*K/Real.log K≤(U.card:ℝ) ∧ ((Ico 1 p).image (fun i => i.factorial%p)).card+U.card≤p-1) :=
  window_of_inputs degree_one_prime_ideal_theorem broad_mass hL hw hb hz hz₁ hA

/-- At least K/(9 log K) distinct eligible lengths in (K,2K] occur, and
each counts toward the missing nonzero residues. -/
theorem dyadic_diverse {A : ℝ} (hA : A<Real.log (32/27)/9) :
    ∀ᶠ K : ℕ in atTop, ∀ᶠ X : ℕ in atTop, 1-Real.exp (-A*K/Real.log K)<fraction X (fun p =>
      let U := GapSieve.hits (family K (2*K)) p
      (1/9:ℝ)*K/Real.log K≤(U.card:ℝ) ∧ ((Ico 1 p).image (fun i => i.factorial%p)).card+U.card≤p-1) := by
  refine ordinary_window (H:=fun K => 2*K) (L:=2) (b:=1/9) (z:=1/2) (by norm_num) ?_ (by norm_num)
    (by norm_num) (by norm_num) ?_
  · apply (tendsto_const_nhds (x:=(2:ℝ))).congr'
    filter_upwards [eventually_gt_atTop 0] with K hK
    push_cast
    field_simp
  · have rate : Real.log (32/27)/9=(1/9)*Real.log (1/2)-(2-1)/3*Real.log ((1+1/2)/2) := by
      rw [show (32/27:ℝ)=(1/2)/(3/4)^3 by norm_num,Real.log_div (by norm_num) (by norm_num),
        Real.log_pow,show ((1+1/2)/2:ℝ)=3/4 by norm_num]
      ring
    exact rate ▸ hA

#print axioms ordinary_window
#print axioms dyadic_diverse
end
end Erdos478.ConditionalGaps
