import Erdos478DiverseLengthTails
import Erdos478ConditionalCollisionLaw
import Erdos478NaturalDensity

/-! # Unconditional ordinary-prime laws for distinct factorial collision lengths -/

namespace Erdos478.ConditionalGaps
open Finset Polynomial Filter Topology GapDensity BinaryGap RootMoments CollisionLaw FrobeniusCounts SplittingDensity
open scoped Classical
noncomputable section

/-- The uniform fixed-point model for a finite family of monic, positive-degree,
separable integral polynomials, with the checked degree-one prime ideal theorem. -/
theorem ordinary_root_observable {I : Type*} [Fintype I] (f : I → ℤ[X]) (K : Type*) [Field K] [Algebra ℚ K]
    [FiniteDimensional ℚ K] [Normal ℚ K] (hf : ∀ i, Good (f i) ∧ ((f i).map (Int.castRingHom K)).Splits)
    (w : (I → ℕ) → ℝ) :
    Tendsto (fun X => ordinary X (fun p => w (fun i => primeRoots (f i) p))) atTop
      (𝓝 (uniform (Aut K) (fun g => w (fun i => fixed K (f i) g)))) :=
  observable_mean (countingAverage degree_one_prime_ideal_theorem) f K hf w

theorem ordinary_conditional (s : Finset Nat.Primes) (l : Nat.Primes)
    (hb : broad l.val) (h3 : 3 < l.val) (small : ∀ i∈s, i.val<l.val) (E : (s → ℕ) → Prop) :
    ∃ d e : ℝ, d≤2*e ∧
      Tendsto (fun X => GapSieve.fraction X (fun p => E (fun i => (endpoints i.val.val p).card))) atTop (𝓝 d) ∧
      Tendsto (fun X => GapSieve.fraction X (fun p => E (fun i => (endpoints i.val.val p).card) ∧
        GapSieve.HasGap p l.val)) atTop (𝓝 e) :=
  conditional_of_pit degree_one_prime_ideal_theorem s l hb h3 small E

/-- The canonical image loss and the specified hit-set event have the exact
ordinary density given by the single finite Galois model. -/
theorem ordinary_certified (s : Finset Nat.Primes) (E : Finset Nat.Primes → Prop) :
    Tendsto (fun X => GapSieve.fraction X (fun p => E (GapSieve.hits s p) ∧
      ((Ico 1 p).image (fun n => n.factorial%p)).card+(GapSieve.hits s p).card≤p-1)) atTop (𝓝 (law s E)) :=
  certified_of_pit degree_one_prime_ideal_theorem s E

/-- For every increasing hit-set event the limiting natural prime density
dominates the independent fair-coin probability. -/
theorem ordinary_domination (s : Finset Nat.Primes) (good : ∀ i∈s, broad i.val ∧ 3 < i.val)
    (E : Finset Nat.Primes → Prop) (inc : Monotone E) :
    fairShare s E≤law s E ∧
      Tendsto (fun X => GapSieve.fraction X (fun p => E (GapSieve.hits s p))) atTop (𝓝 (law s E)) :=
  ⟨increasing_lower s good E inc,law_of_pit degree_one_prime_ideal_theorem s E⟩

/-- Exponential shortfall bound for the count of distinct gap lengths
that are actually witnessed in the upstream positive factorial interval. -/
theorem ordinary_third_shortfall (s : Finset Nat.Primes) (good : ∀ i∈s, broad i.val ∧ 3 < i.val) :
    ∃ d : ℝ, d≤(27/32 : ℝ)^(s.card/3) ∧ Tendsto
      (fun X => GapSieve.fraction X (fun p => (GapSieve.hits s p).card≤s.card/3)) atTop (𝓝 d) :=
  ⟨_,third_upper s good,law_of_pit degree_one_prime_ideal_theorem s (fun u => u.card≤s.card/3)⟩

#print axioms ordinary_root_observable
#print axioms ordinary_conditional
#print axioms ordinary_certified
#print axioms ordinary_domination
#print axioms ordinary_third_shortfall
end
end Erdos478.ConditionalGaps
