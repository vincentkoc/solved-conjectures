import Green28DoubleFibres

/-! Integer multiples of primitive linear elements in a monogenic order, and
the resulting divisor for two-level marginals of a uniform independent sum. -/

namespace Green28PrimitiveOutcomeNorm

open Polynomial Finset Green28 Green28UniformSums Green28AlgebraicWidth Green28DeficientFibre
  Green28DoubleFibres Green28NormOutcomes
open scoped Polynomial ENNReal

/-- Homogeneous evaluation of the integral minimal polynomial at `(-h,t)`. -/
noncomputable def divisor (u : ℝ) (h t : ℤ) : ℤ :=
  ((minpoly ℤ u).scaleRoots t).eval (-h)

private theorem specialization_coprime {p : ℤ[X]} (mon : p.Monic) {h t : ℤ} (cop : IsCoprime h t) :
    IsCoprime ((p.scaleRoots t).eval (-h)) t := by
  rw [eval_eq_sum_range,natDegree_scaleRoots,sum_range_succ]
  simp only [coeff_scaleRoots,tsub_self,pow_zero,mul_one,mon.coeff_natDegree,one_mul]
  have sub : t ∣ ∑ i ∈ range p.natDegree,p.coeff i*t^(p.natDegree-i)*(-h)^i := by
    apply Finset.dvd_sum
    intro i hi
    have lt := mem_range.mp hi
    exact dvd_mul_of_dvd_left (dvd_mul_of_dvd_right (dvd_pow_self _ (by omega : p.natDegree-i ≠ 0)) _) _
  obtain ⟨a,ha⟩ := sub
  rw [ha,add_comm]
  exact cop.neg_left.pow_left.add_mul_left_left a

private theorem scaled_eval {p : ℤ[X]} {h t : ℤ} (tn : t ≠ 0) :
    (((p.scaleRoots t).eval (-h):ℤ):ℚ) =
      (t:ℚ)^p.natDegree*aeval (-(h:ℚ)/(t:ℚ)) p := by
  have nonzero : (t:ℚ) ≠ 0 := by exact_mod_cast tn
  have eq := scaleRoots_eval₂_mul (p := p) (algebraMap ℤ ℚ) (-(h:ℚ)/(t:ℚ)) t
  change eval₂ (algebraMap ℤ ℚ) ((t:ℚ)*(-(h:ℚ)/(t:ℚ))) _ = _ at eq
  rw [show (t:ℚ)*(-(h:ℚ)/(t:ℚ)) = (-(h:ℤ):ℚ) by field_simp] at eq
  calc
    _ = aeval (algebraMap ℤ ℚ (-h)) (p.scaleRoots t) :=
      (aeval_algebraMap_apply_eq_algebraMap_eval _ _).symm
    _ = _ := by simpa only [←aeval_def,eq_intCast,Int.cast_neg] using eq

/-- For primitive integer coefficients a linear element dividing a rational
integer in the order forces the full homogeneous evaluation to divide it. -/
theorem primitive_dvd {u v : ℝ} {h t N : ℤ} (int : IsIntegral ℤ u)
    (cop : IsCoprime h t) (tn : t ≠ 0) (mem : v ∈ Algebra.adjoin ℤ {u})
    (eq : ((h:ℝ)+t*u)*v = (N:ℝ)) : divisor u h t ∣ N := by
  rw [Algebra.adjoin_singleton_eq_range_aeval] at mem
  obtain ⟨p,hp⟩ := mem
  change aeval u p = v at hp
  let f : ℤ[X] := (C h+C t*X)*p-C N
  have zero : aeval u f = 0 := by
    simp only [f,map_sub,map_mul,map_add,aeval_C,aeval_X,hp]; exact sub_eq_zero.mpr eq
  have dv := eval_dvd (x := -h) (scaleRoots_dvd _ _ (r := t) (minpoly.isIntegrallyClosed_dvd int zero))
  have value : (f.scaleRoots t).eval (-h) = t^f.natDegree*(-N) := by
    have ne : (t:ℚ) ≠ 0 := by exact_mod_cast tn
    have eq := scaled_eval (p := f) (h := h) tn
    have e : aeval (-(h:ℚ)/(t:ℚ)) f = -(N:ℚ) := by
      simp only [f,map_sub,map_mul,map_add,aeval_X,eq_intCast,map_intCast]
      rw [show (h:ℚ)+t*(-(h:ℚ)/t) = 0 by field_simp; ring]
      ring
    rw [e] at eq; exact_mod_cast eq
  rw [value] at dv
  exact (dvd_neg.mp ((specialization_coprime (minpoly.monic int) cop).pow_right.dvd_of_dvd_mul_left dv))

private theorem divisor_multiple (u : ℝ) (h t : ℤ) :
    ∃ v ∈ Algebra.adjoin ℤ {u}, ((h:ℝ)+t*u)*v = (divisor u h t:ℝ) := by
  let R := Algebra.adjoin ℤ ({u}:Set ℝ)
  let w : R := ⟨u,Algebra.subset_adjoin (Set.mem_singleton u)⟩
  let m := minpoly ℤ u
  let f := m.scaleRoots t
  have wm : aeval w m = 0 := by
    apply Subtype.ext
    change R.val (aeval w m) = 0
    rw [←aeval_algHom_apply]
    exact minpoly.aeval ℤ u
  have wz : aeval (algebraMap ℤ R t*w) f = 0 := scaleRoots_aeval_eq_zero wm
  obtain ⟨p,hp⟩ := X_sub_C_dvd_sub_C_eval (p := f) (a := -h)
  have eq := congrArg (aeval (algebraMap ℤ R t*w)) hp
  simp only [map_sub,map_mul,aeval_C,aeval_X,wz,zero_sub] at eq
  let v := -aeval (algebraMap ℤ R t*w) p
  refine ⟨(v:R),v.property,?_⟩
  have eq' : ((h:R)+t*w)*v = ((f.eval (-h):ℤ):R) := by
    dsimp [v]
    simp only [eq_intCast,Int.cast_neg] at eq
    linear_combination eq
  exact congrArg Subtype.val eq'

/-- Exact intersection with the rational integers of the principal ideal
generated by a primitive linear element of the order `ℤ[u]`. -/
theorem primitive_criterion {u : ℝ} {h t N : ℤ} (int : IsIntegral ℤ u)
    (cop : IsCoprime h t) (tn : t ≠ 0) :
    (∃ v ∈ Algebra.adjoin ℤ {u}, ((h:ℝ)+t*u)*v = (N:ℝ)) ↔ divisor u h t ∣ N := by
  constructor
  · rintro ⟨v,mem,eq⟩; exact primitive_dvd int cop tn mem eq
  · rintro ⟨n,rfl⟩
    obtain ⟨v,mem,eq⟩ := divisor_multiple u h t
    let R := Algebra.adjoin ℤ ({u}:Set ℝ)
    refine ⟨v*n,R.mul_mem mem (R.intCast_mem n),?_⟩
    push_cast
    rw [←mul_assoc,eq]

private theorem integer_factor {g N : ℤ} {w : ℝ} (gn : g ≠ 0) (wi : IsIntegral ℤ w)
    (eq : (g:ℝ)*w = (N:ℝ)) : g ∣ N := by
  let q := (N:ℚ)/g
  have gnr : (g:ℝ) ≠ 0 := by exact_mod_cast gn
  have cast : (q:ℝ) = w := by dsimp [q]; push_cast; apply (div_eq_iff gnr).mpr; linarith only [eq]
  rw [←cast] at wi
  have qi := (isIntegral_algebraMap_iff (B := ℝ) (algebraMap ℚ ℝ).injective).mp wi
  obtain ⟨n,hn⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ℤ) (K := ℚ)).mp qi
  have nr : (n:ℝ) = w := by rw [←cast,←hn]; norm_num
  exact ⟨n,by exact_mod_cast (show (N:ℝ) = g*n from by rw [nr,eq])⟩

/-- Including a common integer factor multiplies the least integer divisor
by that factor, independently of divisibility between it and the norm. -/
theorem content_criterion {u : ℝ} {g h t N : ℤ} (int : IsIntegral ℤ u) (gn : g ≠ 0)
    (cop : IsCoprime h t) (tn : t ≠ 0) :
    (∃ v ∈ Algebra.adjoin ℤ {u}, (g:ℝ)*((h:ℝ)+t*u)*v = (N:ℝ)) ↔ g*divisor u h t ∣ N := by
  let R := Algebra.adjoin ℤ ({u}:Set ℝ)
  have ur : u ∈ R := Algebra.subset_adjoin (Set.mem_singleton u)
  have ints : R ≤ integralClosure ℤ ℝ := Algebra.adjoin_le (by rintro x (rfl : x = u); exact int)
  have gnr : (g:ℝ) ≠ 0 := by exact_mod_cast gn
  constructor
  · rintro ⟨v,mem,eq⟩
    let w := ((h:ℝ)+t*u)*v
    have wi : IsIntegral ℤ w := ints (R.mul_mem (R.add_mem (R.intCast_mem h)
      (R.mul_mem (R.intCast_mem t) ur)) mem)
    have ev : (g:ℝ)*w = (N:ℝ) := by dsimp [w]; linarith only [eq]
    obtain ⟨n,ne⟩ := integer_factor gn wi ev
    have nr : (n:ℝ) = w := by
      apply mul_left_cancel₀ gnr
      rw [ev]; exact_mod_cast ne.symm
    have dv := primitive_dvd int cop tn mem nr.symm
    obtain ⟨k,hk⟩ := dv
    refine ⟨k,?_⟩
    rw [ne,hk,mul_assoc]
  · rintro ⟨k,rfl⟩
    obtain ⟨v,mem,eq⟩ := divisor_multiple u h t
    refine ⟨v*k,R.mul_mem mem (R.intCast_mem k),?_⟩
    push_cast
    calc
      _ = (g:ℝ)*(((h:ℝ)+t*u)*v)*k := by ring
      _ = _ := by rw [eq]

/-- For any two-level column law, the output count is divisible by the
content of its high/low site counts times the primitive homogeneous norm.
All fibre multiplicities and opposite marginal weights are unrestricted. -/
theorem two_level_outcome {P Q : PMF ℤ} {S : Finset ℤ} (sn : S.Nonempty)
    (sum : indepSum P Q = PMF.uniformOfFinset S sn) {a b : ℤ}
    (pa : IsGreatest P.support a) (qb : IsGreatest Q.support b)
    {H L : Finset ℤ} (supp : Q.support = ↑(H∪L)) (dis : Disjoint H L) (low_ne : L.Nonempty)
    {u : ℝ} (high : ∀ j ∈ H, weight Q b j = 1) (low : ∀ j ∈ L, weight Q b j = u) :
    let g := H.card.gcd L.card
    (g:ℤ)*divisor u ((H.card/g:ℕ):ℤ) ((L.card/g:ℕ):ℤ) ∣ (S.card:ℤ) := by
  classical
  let g := H.card.gcd L.card
  have gn : 0 < g := Nat.gcd_pos_of_pos_right _ low_ne.card_pos
  have cop := Nat.coprime_div_gcd_div_gcd (m := H.card) (n := L.card) gn
  have hg : g*(H.card/g) = H.card := Nat.mul_div_cancel' (Nat.gcd_dvd_left _ _)
  have lg : g*(L.card/g) = L.card := Nat.mul_div_cancel' (Nat.gcd_dvd_right _ _)
  have ln : L.card/g ≠ 0 := by intro h; rw [h,mul_zero] at lg; exact low_ne.card_pos.ne' lg.symm
  have flat : IsUniformOnSupport (indepSum P Q) := ⟨S,sn,sum⟩
  obtain ⟨pf,qf⟩ := finite_of_uniform_sum flat
  obtain ⟨e,qe,top,ws⟩ := (endpoint_weights flat).2
  obtain rfl := qb.unique (show IsGreatest Q.support e from ⟨qe,top⟩)
  obtain ⟨l,hl⟩ := low_ne
  have int : IsIntegral ℤ u := low l hl ▸ (ws l).2.2.1
  let R := Algebra.adjoin ℤ ({u}:Set ℝ)
  have inc (j : ℤ) (hj : j ∈ Q.support) : weight Q b j ∈ R.toSubring := by
    rw [supp] at hj
    rcases mem_union.mp hj with hi|lo
    · rw [high j hi]; exact R.one_mem
    · rw [low j lo]; exact Algebra.subset_adjoin (Set.mem_singleton u)
  let v := ∑ i ∈ pf.toFinset,weight P a i
  have mem : v ∈ R := R.sum_mem fun i hi => weight_mem_ring flat pa qb R.toSubring inc (pf.mem_toFinset.mp hi)
  have dv := (content_criterion (N := (S.card:ℤ)) int (by exact_mod_cast gn.ne' : (g:ℤ) ≠ 0)
    (Nat.isCoprime_iff_coprime.mpr cop) (by exact_mod_cast ln : ((L.card/g:ℕ):ℤ) ≠ 0)).mp
  apply dv ⟨v,mem,?_⟩
  have eq : qf.toFinset = H∪L := Finset.coe_inj.mp (qf.coe_toFinset.trans supp)
  have sumQ := sum_normalized_weights qf b
  rw [eq,sum_union dis,sum_congr rfl high,sum_congr rfl low] at sumQ
  simp only [sum_const,nsmul_eq_mul,mul_one] at sumQ
  have mass := endpoint_product_card sn sum pf pa qb
  have vp : v = 1/(P a).toReal := sum_normalized_weights pf a
  have hgr : (g:ℝ)*(H.card/g:ℕ) = H.card := by exact_mod_cast hg
  have lgr : (g:ℝ)*(L.card/g:ℕ) = L.card := by exact_mod_cast lg
  simp only [Int.cast_natCast]
  change ((g:ℝ)*((H.card/g:ℕ)+(L.card/g:ℕ)*u))*v = (S.card:ℝ)
  rw [mul_add,←mul_assoc,lgr,hgr,sumQ,vp]
  have pn := (ENNReal.toReal_pos ((P.mem_support_iff _).mp pa.1) (P.apply_ne_top _)).ne'
  have qn := (ENNReal.toReal_pos ((Q.mem_support_iff _).mp qb.1) (Q.apply_ne_top _)).ne'
  field_simp [pn,qn]
  linarith only [mass]

/-- A positive divisor common to the sizes of all classes of equal occupied probabilities. -/
def MultiplicityDivides (P : PMF ℤ) (g : ℕ) : Prop :=
  ∀ i ∈ P.support, g ∣ ({j | j ∈ P.support ∧ P j = P i}:Set ℤ).ncard

private theorem grouped_total {P : PMF ℤ} (pf : P.support.Finite) (ep : EndpointWeights P)
    {a : ℤ} (pa : IsGreatest P.support a) {g : ℕ} (prof : MultiplicityDivides P g) :
    ∃ v : ℝ, IsIntegral ℤ v ∧ (g:ℝ)*v = 1/(P a).toReal := by
  classical
  let F := pf.toFinset
  let W := F.image P
  let fibre (c : ℝ≥0∞) := F.filter fun i => P i = c
  let w (c : ℝ≥0∞) := c.toReal/(P a).toReal
  obtain ⟨a',mem,top,ws⟩ := ep
  obtain rfl := pa.unique (show IsGreatest P.support a' from ⟨mem,top⟩)
  have data (c : ℝ≥0∞) (hc : c ∈ W) : IsIntegral ℤ (w c) ∧ g ∣ (fibre c).card := by
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hc
    have seteq : {j | j ∈ P.support ∧ P j = P i}=(fibre (P i):Set ℤ) := by ext j; simp [F,fibre]
    have dv := prof i (pf.mem_toFinset.mp hi)
    rw [seteq,Set.ncard_coe_finset] at dv
    exact ⟨(ws i).2.2.1,dv⟩
  let v := ∑ c ∈ W,((fibre c).card/g:ℕ)*w c
  refine ⟨v,?_,?_⟩
  · apply (integralClosure ℤ ℝ).sum_mem
    intro c hc
    exact (integralClosure ℤ ℝ).mul_mem ((integralClosure ℤ ℝ).natCast_mem _) (data c hc).1
  · rw [←sum_normalized_weights pf a]
    have group := Finset.sum_fiberwise_of_maps_to (s := F) (t := W) (g := P)
      (fun i hi => mem_image_of_mem P hi) (weight P a)
    calc
      (g:ℝ)*v = ∑ c ∈ W,((fibre c).card:ℝ)*w c := by
        dsimp only [v]; rw [mul_sum]
        apply sum_congr rfl
        intro c hc
        rw [←mul_assoc,←Nat.cast_mul,Nat.mul_div_cancel' (data c hc).2]
      _ = _ := by
        apply Eq.trans _ group
        apply sum_congr rfl
        intro c hc
        have eq : (∑ i ∈ fibre c, weight P a i) = ∑ _ ∈ fibre c,w c := by
          apply sum_congr rfl
          intro i hi; rw [weight,(mem_filter.mp hi).2]
        simpa only [sum_const,nsmul_eq_mul] using eq.symm

/-- For arbitrary marginals of a uniform independent integer sum, the product
of the two mass-class multiplicity divisors divides the number of output sites. -/
theorem profile_product_dvd {P Q : PMF ℤ} {S : Finset ℤ} (sn : S.Nonempty)
    (sum : indepSum P Q = PMF.uniformOfFinset S sn) {g h : ℕ+}
    (left : MultiplicityDivides P g) (right : MultiplicityDivides Q h) :
    (g:ℕ)*(h:ℕ) ∣ S.card := by
  classical
  have flat : IsUniformOnSupport (indepSum P Q) := ⟨S,sn,sum⟩
  obtain ⟨pf,qf⟩ := finite_of_uniform_sum flat
  obtain ⟨ep,eq⟩ := endpoint_weights flat
  obtain ⟨a,pa,pt,_⟩ := ep
  obtain ⟨b,qb,qt,_⟩ := eq
  have pp : IsGreatest P.support a := ⟨pa,pt⟩
  have qq : IsGreatest Q.support b := ⟨qb,qt⟩
  obtain ⟨v,vi,vp⟩ := grouped_total pf (endpoint_weights flat).1 pp left
  obtain ⟨w,wi,wq⟩ := grouped_total qf (endpoint_weights flat).2 qq right
  have mass := endpoint_product_card sn sum pf pp qq
  have ap := (ENNReal.toReal_pos ((P.mem_support_iff _).mp pa) (P.apply_ne_top _)).ne'
  have bp := (ENNReal.toReal_pos ((Q.mem_support_iff _).mp qb) (Q.apply_ne_top _)).ne'
  have out := integer_factor (g := ((g:ℕ)*(h:ℕ):ℕ)) (N := (S.card:ℤ))
    (by exact_mod_cast (Nat.mul_pos g.pos h.pos).ne') (vi.mul wi) (by
      push_cast
      rw [mul_mul_mul_comm, vp,wq]
      field_simp [ap,bp]; linarith only [mass])
  exact_mod_cast out

/-- With a prime number of output sites and at least two opposite sites,
the multiplicities of the distinct positive probabilities have no common
positive divisor greater than one. -/
theorem primitive_profile_of_prime {P Q : PMF ℤ} {S : Finset ℤ} (sn : S.Nonempty)
    (sum : indepSum P Q = PMF.uniformOfFinset S sn) (prime : S.card.Prime)
    (opposite : ∃ b ∈ Q.support, ∃ c ∈ Q.support, b < c) {g : ℕ+}
    (prof : MultiplicityDivides P g) : g = 1 := by
  classical
  have flat : IsUniformOnSupport (indepSum P Q) := ⟨S,sn,sum⟩
  obtain ⟨pf,_⟩ := finite_of_uniform_sum flat
  let A := pf.toFinset
  have an : A.Nonempty := pf.toFinset_nonempty.mpr P.support_nonempty
  let a := A.max' an
  have ha : a ∈ A := A.max'_mem an
  obtain ⟨b,qb,c,qc,bc⟩ := opposite
  have hit {i j : ℤ} (hi : i ∈ A) (hj : j ∈ Q.support) : i+j ∈ S := by
    have site : i+j ∈ (indepSum P Q).support := (PMF.mem_support_bind_iff _ _ _).mpr
      ⟨i,pf.mem_toFinset.mp hi,(PMF.mem_support_bind_iff _ _ _).mpr
        ⟨j,hj,(PMF.mem_support_pure_iff _ _).mpr rfl⟩⟩
    simpa only [sum,PMF.support_uniformOfFinset,mem_coe] using site
  have sub : A.image (·+b) ⊆ S.erase (a+c) := by
    intro z hz
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hz
    have le : i ≤ a := A.le_max' i hi
    exact mem_erase.mpr ⟨by omega,hit hi qb⟩
  have few := card_le_card sub
  rw [card_image_of_injective _ (add_left_injective b)] at few
  have less := card_erase_lt_of_mem (hit ha qc)
  let B := A.filter fun j => P j = P a
  have eq : {j | j ∈ P.support ∧ P j = P a}=(B:Set ℤ) := by ext j; simp [B,A]
  have dv := prof a (pf.mem_toFinset.mp ha)
  rw [eq,Set.ncard_coe_finset] at dv
  have le := Nat.le_of_dvd (card_pos.mpr (show B.Nonempty from ⟨a,mem_filter.mpr ⟨ha,rfl⟩⟩)) dv
  have inc : B.card ≤ A.card := card_le_card (filter_subset _ _)
  have out := profile_product_dvd (h := 1) sn sum prof (fun _ _ => one_dvd _)
  simp only [PNat.val_ofNat,mul_one] at out
  rcases (Nat.dvd_prime prime).mp out with one|same
  · exact Subtype.ext one
  · omega

