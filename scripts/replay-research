#!/usr/bin/env python3
"""Replay the notebook inside the pinned Formal Conjectures Lake environment."""

import argparse
import json
import os
import re
import subprocess
import tempfile
from graphlib import TopologicalSorter
from pathlib import Path


RESEARCH = Path(__file__).resolve().parents[1] / "research"
ALLOWED_AXIOMS = {"propext", "Classical.choice", "Quot.sound"}
KERNEL_REPLAY = """import LeanChecker

#eval show IO Unit from do
  let some target ← IO.getEnv "RESEARCH_REPLAY_MODULE" | throw (IO.userError "missing replay module")
  let some paths ← IO.getEnv "RESEARCH_REPLAY_PATH" | throw (IO.userError "missing replay search path")
  Lean.initSearchPath (← Lean.findSysroot) (System.SearchPath.parse paths)
  replayFromImports (.str .anonymous target)
"""


def compile_proof(source, out, env):
    result = subprocess.run(
        ["lean", "--json", "-o", out / (source.stem + ".olean"), source.name],
        cwd=source.parent, env=env, text=True, stdout=subprocess.PIPE,
    )
    reports = 0
    for line in result.stdout.splitlines():
        message = json.loads(line)
        data = message["data"]
        print(data, flush=True)
        if message["kind"] == "hasSorry":
            raise SystemExit(f"{source.name}: proof contains sorry")
        if message["severity"] == "information":
            match = re.fullmatch(r"'([^\n]+)' depends on axioms:\s*\[(.*?)\]", data, re.S)
            if match:
                declaration, axioms = match.groups()
                extra = {name.strip() for name in axioms.split(",")} - ALLOWED_AXIOMS
                if extra:
                    raise SystemExit(f"{source.name}: {declaration}: unexpected axioms {sorted(extra)}")
                reports += 1
            elif re.fullmatch(r"'[^\n]+' does not depend on any axioms", data):
                reports += 1
    result.check_returncode()
    if not reports:
        raise SystemExit(f"{source.name}: missing #print axioms report")


def replay_kernel(sources, env):
    # Import the toolchain's checker first. Its replay uses the same path as compilation.
    checker_env = env.copy()
    checker_env["RESEARCH_REPLAY_PATH"] = checker_env.pop("LEAN_PATH")
    for source in sources:
        print(f"replaying {source.stem}", flush=True)
        subprocess.run(
            ["lean", "--stdin"], input=KERNEL_REPLAY, text=True, check=True,
            env=checker_env | {"RESEARCH_REPLAY_MODULE": source.stem},
        )


def qualified_imports(resolved, sources, env):
    # The pinned Lean compiler emits import names and source paths in header order.
    headers = json.loads(subprocess.check_output(
        ["lean", "--deps-json", "--stdin"], input="\n".join(map(str, resolved)),
        env=env, text=True,
    ))["imports"]
    if len(headers) != len(resolved):
        raise SystemExit("Lean returned an incomplete import list.")
    aliases = set()
    for (source, paths), header in zip(resolved.items(), headers):
        if header["errors"]:
            raise SystemExit(f"{source.name}: {header['errors']}")
        imports = header["result"]["imports"]
        if len(imports) != len(paths):
            raise SystemExit(f"{source.name}: Lean import names and source paths disagree.")
        for item, path in zip(imports, paths):
            if path in sources and item["module"].startswith("research."):
                aliases.add(path)
    return aliases


def compile_alias(source, out, env):
    # Both import spellings must lead back to a single copy of the declarations.
    relative = source.relative_to(RESEARCH.parent)
    alias = out / relative
    alias.parent.mkdir(parents=True, exist_ok=True)
    alias.write_text(
        f"import «{source.stem}»\n\n/-! Re-export the checked notebook proof under its qualified name. -/\n",
        encoding="utf-8",
    )
    subprocess.run(["lean", "-o", alias.with_suffix(".olean"), relative], cwd=out, env=env, check=True)


def dependency_order(selected, sources, upstream, env):
    graph = TopologicalSorter()
    targets = set()
    resolved = {}
    pending = list(reversed(selected))
    while pending:
        source = pending.pop()
        if source in resolved:
            continue
        deps = subprocess.check_output(["lean", "--src-deps", source], env=env, text=True)
        resolved[source] = [Path(line).resolve() for line in deps.splitlines()]
        paths = set(resolved[source])
        local = sorted(paths & sources)
        graph.add(source, *local)
        pending.extend(reversed(local))
        for path in paths - sources:
            if path.is_relative_to(upstream) and not path.is_relative_to(upstream / ".lake"):
                targets.add(str(path.relative_to(upstream)) + ":olean")
    return list(graph.static_order()), sorted(targets), qualified_imports(resolved, sources, env)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "modules", metavar="MODULE", nargs="*",
        help="bare notebook module name (default: replay the whole notebook)",
    )
    args = parser.parse_args()
    upstream = Path.cwd().resolve()
    if not (upstream / "FormalConjectures").is_dir() or not os.environ.get("LEAN_PATH"):
        raise SystemExit("Run from the Formal Conjectures checkout with lake env python3.")
    files = sorted(RESEARCH.rglob("*.lean"))
    if not files:
        raise SystemExit("No notebook modules found.")
    by_name = {f.stem: f for f in files}
    if len(by_name) != len(files):
        raise SystemExit("Notebook module names must be unique for bare Lean imports.")
    unknown = sorted(set(args.modules) - by_name.keys())
    if unknown:
        parser.error("unknown notebook module: " + ", ".join(unknown))
    selected = [by_name[name] for name in args.modules] if args.modules else files
    roots = sorted({str(f.parent) for f in files})
    env = os.environ.copy()
    env["LEAN_SRC_PATH"] = os.pathsep.join([str(RESEARCH.parent), *roots, env["LEAN_SRC_PATH"]])
    order, targets, aliases = dependency_order(selected, set(files), upstream, env)
    if targets:
        subprocess.run(["lake", "build", *targets], check=True)

    with tempfile.TemporaryDirectory(prefix="conjecture-replay-") as directory:
        out = Path(directory)
        env["LEAN_PATH"] = os.pathsep.join([directory, env["LEAN_PATH"]])
        for source in order:
            print(f"Checking {source.relative_to(RESEARCH)}", flush=True)
            compile_proof(source, out, env)
            if source in aliases:
                compile_alias(source, out, env)
        replay_kernel(order, env)
    print(f"Replayed {len(order)} notebook modules.")


if __name__ == "__main__":
    main()
